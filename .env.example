# From https://my.telegram.org -> API development tools
TG_API_ID=
TG_API_HASH=
# Created once by running: python login.py   (keep it SECRET: it is full access to your account)
TG_SESSION=
# Free key from https://console.groq.com
GROQ_API_KEY=
# Optional
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_VISION_MODEL=meta-llama/llama-4-scout-17b-16e-instruct
GROQ_WHISPER_MODEL=whisper-large-v3-turbo
DB_PATH=userbot.db
# Optional: store settings in Postgres (e.g. Neon) instead of a local file. Needed on hosts without a disk (Render free web service).
DATABASE_URL=
# Optional: alerts through a normal bot if Saved Messages can't be reached
ALERT_BOT_TOKEN=
ALERT_CHAT_ID=
# Optional experimental voice replies
GROQ_TTS_MODEL=canopylabs/orpheus-v1-english
GROQ_TTS_VOICE=autumn
